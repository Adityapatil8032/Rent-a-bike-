# Supabase project URL and anon key for Google auth, email/password auth, and database.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional Gemini key for the AI ride assistant and chatbot.
# In Vite, prefer the VITE_ prefixed variable for direct browser access.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini model override.
VITE_GEMINI_MODEL="gemini-3.5-flash"

# Optional OpenAI key for the AI ride assistant and chatbot.
VITE_OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Optional OpenAI model override.
VITE_OPENAI_MODEL="gpt-5.5"

# Backward-compatible fallback used by older AI Studio setups.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
